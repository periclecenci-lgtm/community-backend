# =========================
# Database
# =========================
DATABASE_URL=postgresql://username:password@localhost:5432/community_database

# =========================
# Runtime / Server
# =========================
NODE_ENV=development
PORT=4001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
PUBLIC_COMMUNITY_BASE_URL=http://localhost:3000

# =========================
# Session
# =========================
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=sbelm_comm_sess
SESSION_TTL_SECONDS=1209600

# =========================
# Email
# =========================
RESEND_API_KEY=re_replace_with_your_api_key
EMAIL_FROM=SBELM Community <no-reply@sbelm.xyz>

# =========================
# Blockchain / Commander
# =========================
FX_RPC_URL=https://replace-with-your-rpc-url
FX_CHAIN_ID=11155111
FX_MODEL3_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
FX_COMMANDER_THRESHOLD=500
FX_MODEL3_TOKEN_DECIMALS=18
FX_COMMANDER_CHECK_INTERVAL_SECONDS=1800

# =========================
# Governance bootstrap
# =========================
DEVELOPMENT_FOUNDER_EMAIL=founder@example.com