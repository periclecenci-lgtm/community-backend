# =========================
# Runtime
# =========================
NODE_ENV=production

# =========================
# API / Server
# =========================
PUBLIC_COMMUNITY_BASE_URL=https://community.sbelm.xyz

# =========================
# Session
# =========================
SESSION_COOKIE_NAME=sbelm_comm_sess
SESSION_TTL_SECONDS=1209600

# =========================
# Email (SMTP)
# =========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=SBELM Community <no-reply@sbelm.xyz>

# =========================
# Blockchain / FX
# =========================
FX_CHAIN_ID=11155111
FX_COMMANDER_THRESHOLD=500
FX_COMMANDER_CHECK_INTERVAL_SECONDS=1800
FX_MODEL3_TOKEN_DECIMALS=18
